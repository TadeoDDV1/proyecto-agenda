// Prisma Schema para SaaS Multi-tenant de Agendas (Salones de belleza, Barberías, Spas)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  phone       String?
  address     String?
  currency    String   @default("USD")
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  staff        StaffProfile[]
  categories   Category[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]

  @@map("tenants")
}

model User {
  id           String        @id @default(uuid())
  tenantId     String
  email        String        @unique
  passwordHash String
  fullName     String
  role         UserRole      @default(STAFF)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile?

  @@index([tenantId])
  @@map("users")
}

model StaffProfile {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?  @unique
  displayName String
  phone       String?
  email       String?
  avatarUrl   String?
  colorCode   String   @default("#3b82f6")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules    Schedule[]
  services     StaffService[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("staff_profiles")
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  categoryId      String?
  name            String
  description     String?
  durationMinutes Int      @default(30)
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff        StaffService[]
  appointments Appointment[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("services")
}

model StaffService {
  staffId   String
  serviceId String

  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model Schedule {
  id           String   @id @default(uuid())
  staffId      String
  dayOfWeek    Int      // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  startTime    String   @default("09:00") // Formato "HH:mm"
  endTime      String   @default("18:00") // Formato "HH:mm"
  hasBreak     Boolean  @default(false)
  breakStart   String?  // Formato "HH:mm" ej "13:00"
  breakEnd     String?  // Formato "HH:mm" ej "14:00"
  isWorkingDay Boolean  @default(true)

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("schedules")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  fullName  String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

model Appointment {
  id            String            @id @default(uuid())
  tenantId      String
  staffId       String
  serviceId     String
  customerId    String
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(CONFIRMED)
  totalPrice    Decimal           @db.Decimal(10, 2)
  customerNotes String?
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId, startTime])
  @@index([tenantId, startTime])
  @@map("appointments")
}
