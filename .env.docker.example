# =============================================================================
# .env.docker.example — variables de entorno para Docker Compose
# =============================================================================
# Copia este archivo a `.env.docker` y ajusta los valores:
#   Windows (PowerShell):  Copy-Item .env.docker.example .env.docker
#   Linux / macOS:         cp .env.docker.example .env.docker
#
# Después ejecuta:
#   docker compose --env-file .env.docker --profile setup run --rm migrate
#   docker compose --env-file .env.docker up -d --build
#
# Sin `--env-file`, Compose lee el `.env` del proyecto (el de desarrollo), que
# también tiene JWT_SECRET y sirve para probar en local.
#
# `.env.docker` está ignorado por git (regla `.env*`), así que puedes guardar
# aquí secretos reales sin miedo a subirlos al repositorio.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Dentro de Docker la app NO usa "127.0.0.1" sino el servicio `db`.
# docker-compose.yml ya fija DATABASE_URL con el host `db:5432`; esta variable
# se documenta como referencia y para herramientas externas.
#
# Si descomentas el mapeo "5433:5432" del servicio `db` en docker-compose.yml,
# desde tu máquina (Prisma Studio, psql, DBeaver...) usa:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/proyecto_agenda?schema=public"
DATABASE_URL="postgresql://postgres:postgres@db:5432/proyecto_agenda?schema=public"

# --- Seguridad ---------------------------------------------------------------
# Secreto con el que se firman los JWT de sesión de los usuarios.
# ⚠️ CAMBIA este valor antes de desplegar en producción.
# Para generar uno aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="agenda_saas_dev_secret_2026_cambiar_en_produccion"

# --- Datos demo (servicio `migrate`) -----------------------------------------
# 1 = después de `prisma db push` carga prisma/seed-test.ts (negocios,
#     usuarios, servicios y citas de ejemplo).
# 0 = solo crea el esquema, sin datos.
SEED_DEMO=0

# --- Etapa de build del servicio `migrate` -----------------------------------
# Debe ser una etapa del Dockerfile que tenga node_modules con prisma y tsx.
# El Dockerfile multi-stage estándar de Next.js la llama "builder", por eso es
# el valor por defecto; descomenta solo si tu Dockerfile usa otro nombre.
# MIGRATE_BUILD_TARGET=builder

# --- WhatsApp Cloud API (opcional) -------------------------------------------
# Descomenta y completa para activar el chatbot de WhatsApp.
# Si falta WA_TOKEN, el webhook solo registra los mensajes en el log (modo
# desarrollo) y no responde por la API de Meta.
# WA_VERIFY_TOKEN="agenda-verify"
# WA_TOKEN="EAAG...token-de-Meta..."
# WA_PHONE_MAP='{"109876543210":"barberia-vintage"}'
# WA_DEFAULT_TENANT="barberia-vintage"
